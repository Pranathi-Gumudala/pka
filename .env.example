# Copy to .env and fill in local credentials. Never commit .env.
DB_URL=jdbc:mysql://localhost:3306/pka_db
DB_USERNAME=root
DB_PASSWORD=change-me

VECTOR_DB_URL=jdbc:postgresql://localhost:5433/pka_vectors
VECTOR_DB_USERNAME=pka_vector
VECTOR_DB_PASSWORD=replace-with-a-long-random-password

# Hosted chat provider: gemini (default) or ollama.
AI_CHAT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Ollama is still used for embeddings; install/pull the embedding model locally.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5-coder:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Must be identical for Spring Boot and the Python agent. Generate a long random value.
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-secret

PYTHON_AGENT_URL=http://127.0.0.1:8000
SPRING_BOOT_URL=http://127.0.0.1:8080
RETRIEVAL_TOP_K=5
UPLOAD_MAX_FILE_SIZE=15MB
UPLOAD_MAX_REQUEST_SIZE=15MB
