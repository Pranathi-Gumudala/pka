# Copy values into your shell environment or a local .env file managed by your own tooling.
# Do not commit real credentials.
DB_URL=jdbc:mysql://localhost:3306/pka_db
DB_USERNAME=root
DB_PASSWORD=replace_with_your_mysql_password

OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

VECTOR_DB_URL=jdbc:postgresql://localhost:5433/pka_vectors
VECTOR_DB_USERNAME=pka_vector
VECTOR_DB_PASSWORD=replace_with_a_local_vector_db_password
